{{- /* Auto-detect environment */ -}}
{{- $isContainer := or (stat "/.dockerenv") (stat "/run/.containerenv") (stat "/var/devcontainer") (env "CODESPACES") (env "REMOTE_CONTAINERS") (env "container") | not | not -}}
{{- $isOmarchy := or (lookPath "omarchy") (stat (joinPath .chezmoi.homeDir ".local/share/omarchy")) | not | not -}}
{{- $omarchyVersion := "" -}}
{{- $isOmarchy4 := false -}}
{{- if $isOmarchy -}}
{{-   $omarchyVersion = output "omarchy" "version" | trim -}}
{{-   $isOmarchy4 = $omarchyVersion | hasPrefix "4." -}}
{{- end -}}
{{- $hasNvidiaGPU := false -}}
{{- if and (not $isContainer) (lookPath "lspci") -}}
{{-   $hasNvidiaGPU = output "lspci" | lower | contains "nvidia" -}}
{{- end -}}

{{- /*
Platform-provided environment.

Two independent facts, deliberately separate, because they gate different
recipes and are owned by different parties:

  hasToolchain   The global mise configuration belongs to the platform, not
                 to this user. A provisioned guest bakes mise and its toolset
                 into the image, points MISE_GLOBAL_CONFIG_FILE at a path
                 outside $HOME, and expects the user not to write to it.
                 Dotfiles must not install tools through `mise use -g` here:
                 it would write the platform's config, unpin the versions the
                 platform deliberately pinned, and lose the change when the
                 container is replaced.

  hydratesHome   The platform writes managed blocks into ~/.bashrc and
                 ~/.zshrc. Dotfiles must merge into those files instead of
                 replacing them, or it silently drops the platform's setup.

Both are detected from the environment rather than from a product name, so
they stay meaningful if the platform changes.
*/ -}}
{{- $miseGlobalConfig := env "MISE_GLOBAL_CONFIG_FILE" | default "" | trim -}}
{{- $hasToolchain := false -}}
{{- if $miseGlobalConfig -}}
{{- /* An explicitly redirected global config outside home signals platform ownership. */ -}}
{{-   $homePrefix := joinPath .chezmoi.homeDir "/" -}}
{{-   $hasToolchain = and (ne $miseGlobalConfig .chezmoi.homeDir) (not (hasPrefix $homePrefix $miseGlobalConfig)) -}}
{{- end -}}
{{- $hydratesHome := false -}}
{{- if stat "/usr/local/share/bb/managed.tsv" -}}
{{-   $hydratesHome = true -}}
{{- else -}}
{{- /* Fall back to a managed-block marker in an existing rc file. */ -}}
{{- /* The dotfiles block carries a marker of its own, so exclude it. */ -}}
{{-   $rcProbe := printf "awk '/managed >>>/ && !/^# dotfiles managed >>>/ { found = 1 } END { exit !found }' %q 2>/dev/null" (joinPath .chezmoi.homeDir ".bashrc") -}}
{{-   $marker := output "sh" "-c" (printf "%s && echo yes || echo no" $rcProbe) -}}
{{-   $hydratesHome = eq ($marker | trim) "yes" -}}
{{- end -}}

sourceDir = "{{ .chezmoi.workingTree }}"

[hooks.read-source-state.pre]
    command = "chezmoi-recipes"
    args = ["overlay", "--recipes-dir", "{{ .chezmoi.workingTree }}/recipes"]

[hooks.add.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi add (compiled-home/ is generated)' >&2; exit 1"]

[hooks.edit.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi edit (compiled-home/ is generated)' >&2; exit 1"]

[hooks.re-add.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi re-add (compiled-home/ is generated)' >&2; exit 1"]

[hooks.merge.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi merge (compiled-home/ is generated)' >&2; exit 1"]

[hooks.chattr.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi chattr (compiled-home/ is generated)' >&2; exit 1"]

[hooks.import.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi import (compiled-home/ is generated)' >&2; exit 1"]

[hooks.forget.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi forget (compiled-home/ is generated)' >&2; exit 1"]

[hooks.destroy.pre]
    command = "sh"
    args = ["-c", "echo 'Error: use home/ or recipes/ instead of chezmoi destroy (compiled-home/ is generated)' >&2; exit 1"]

# Prevent chezmoi from paging diffs through $PAGER (e.g. less), which causes
# script content diffs to get mingled with script execution output in -v mode.
[diff]
  pager = "cat"

[data]
    recipesDir = "{{ .chezmoi.workingTree }}/recipes"
    name = {{ promptStringOnce . "name" "Full name" | quote }}
    email = {{ promptStringOnce . "email" "Email" | quote }}
    {{- if or $isContainer (not $isOmarchy) }}
    onepasswordSshVault = ""
    onepasswordSshItem = ""
    {{- else }}
    onepasswordSshVault = {{ promptStringOnce . "onepasswordSshVault" "1Password vault for SSH keys [Keys]" | default "Keys" | quote }}
    onepasswordSshItem = {{ promptStringOnce . "onepasswordSshItem" "1Password item for SSH keys [SSH]" | default "SSH" | quote }}
    {{- end }}
    {{- if $isOmarchy }}
    installVantaAgent = {{ promptBoolOnce . "installVantaAgent" "Install the Vanta user agent?" }}
    {{- else }}
    installVantaAgent = false
    {{- end }}
    isContainer = {{ $isContainer }}
    isOmarchy = {{ $isOmarchy }}
    omarchyVersion = {{ $omarchyVersion | quote }}
    isOmarchy4 = {{ $isOmarchy4 }}
    hasNvidiaGPU = {{ $hasNvidiaGPU }}
    hasToolchain = {{ $hasToolchain }}
    hydratesHome = {{ $hydratesHome }}
