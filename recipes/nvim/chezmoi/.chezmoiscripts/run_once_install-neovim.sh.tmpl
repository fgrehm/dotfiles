#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"
source "$CHEZMOI_SOURCE_DIR/scripts/privilege.bash"
setup_sudo

if command -v nvim &>/dev/null; then
  log_skip "Neovim already installed"
  exit 0
fi

VERSION="0.12.4"
ARCHIVE="/tmp/nvim-linux-x86_64.tar.gz"
SHA256="012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628"

set -eo pipefail

if [ "$(id -u)" -ne 0 ] && [ -z "$SUDO" ]; then
  log_skip "Cannot install Neovim globally without root or usable sudo"
  exit 0
fi

log_info "Installing Neovim..."
# Installed globally (/opt + /usr/local/bin) so `sudo nvim` works.
# https://github.com/neovim/neovim/releases
run_quiet wget -qO "$ARCHIVE" \
  "https://github.com/neovim/neovim/releases/download/v${VERSION}/nvim-linux-x86_64.tar.gz"
if ! echo "${SHA256}  ${ARCHIVE}" | sha256sum -c --status; then
  log_error "Neovim archive checksum mismatch -- potential tampering, aborting"
  rm -f "$ARCHIVE"
  exit 1
fi
run_quiet $SUDO tar -C /opt -xzf "$ARCHIVE"
$SUDO ln -sf "/opt/nvim-linux-x86_64/bin/nvim" /usr/local/bin/nvim
rm -f "$ARCHIVE"
