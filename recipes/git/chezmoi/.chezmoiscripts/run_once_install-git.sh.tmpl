#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

if command -v git &>/dev/null; then
  log_skip "git already installed"
  exit 0
fi

# Use sudo only when it is authorized without prompting.
if [ "$(id -u)" -ne 0 ] && command -v sudo &>/dev/null && sudo -n true 2>/dev/null; then
  SUDO="sudo"
else
  SUDO=""
fi

set -eo pipefail

if [ "$(id -u)" -ne 0 ] && [ -z "$SUDO" ]; then
  log_skip "Cannot install git without root or usable sudo"
  exit 0
fi

log_info "Installing git..."
# Omarchy: pacman. Containers: apt.
# {{ if .isOmarchy }}
run_quiet $SUDO pacman -S --noconfirm --needed git
# {{ else }}
run_quiet $SUDO apt-get update -qq
run_quiet $SUDO apt-get install -y git
# {{ end }}
