# vim: ft=gitconfig.gotmpl
{{ if or (ne .name "TODO: Your Name") (ne .email "TODO@example.com") -}}
[user]
{{- if ne .email "TODO@example.com" }}
	email = {{ .email }}
{{- end }}
{{- if ne .name "TODO: Your Name" }}
	name = {{ .name }}
{{- end }}
{{ end -}}
[color]
	branch = auto
	status = auto
	diff = auto
	grep = auto
[push]
	default = tracking
[grep]
	extendRegexp = true
	lineNumber = true
[status]
	relativePaths = true
	short = true
	branch = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[diff]
	colorMoved = zebra
	algorithm = histogram
[pull]
	rebase = false
[fetch]
	prune = true
[init]
	defaultBranch = main
