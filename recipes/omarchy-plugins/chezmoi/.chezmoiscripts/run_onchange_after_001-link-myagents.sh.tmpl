#!/bin/sh
# vim: ft=sh.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
set -eu

plugin="$HOME/.config/omarchy/plugins/fgrehm.myagents"
# Leading "# " in source is consumed by the template's custom action delimiter.
source="# {{ .chezmoi.workingTree }}/config/omarchy-plugins/fgrehm.myagents"

if [ -e "$plugin" ] && [ ! -L "$plugin" ]; then
  rm -rf "$plugin"
fi
if [ -L "$plugin" ] && [ "$(readlink "$plugin")" != "$source" ]; then
  rm "$plugin"
fi
if [ ! -e "$plugin" ] && [ ! -L "$plugin" ]; then
  ln -s "$source" "$plugin"
fi
