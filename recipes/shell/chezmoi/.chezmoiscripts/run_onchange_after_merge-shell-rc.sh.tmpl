#!/usr/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
#
# Merge the dotfiles shell block into a platform-hydrated ~/.bashrc and
# ~/.zshrc.
#
# A provisioned guest owns its own shell rc files: the platform writes managed
# blocks into them (mise activation, toolchain setup) and replaces them on
# every boot. Deploying our own whole file would silently drop those blocks,
# so on such a home chezmoi skips the rc files entirely and this script
# maintains a marked block of our own inside them instead.
#
# The block is refreshed in place, so re-running is a no-op and edits the user
# made outside the markers are preserved.
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

set -eo pipefail

OPEN_MARKER="# dotfiles managed >>>"
CLOSE_MARKER="# dotfiles managed <<<"

SNIPPET="$(mktemp)"
TMPFILE=""
trap 'rm -f "$SNIPPET" ${TMPFILE:+"$TMPFILE"}' EXIT
cat >"$SNIPPET" <<'DOTFILES_SHELLRC_BLOCK'
# {{ include ".chezmoitemplates/shellrc-block.sh" }}
DOTFILES_SHELLRC_BLOCK

# Replace the marked block in $1 with the snippet, or append it when the file
# has no block yet. Everything outside the markers is left alone.
merge_block() {
  local target="$1"
  local tmp

  if [ ! -f "$target" ]; then
    {
      printf '%s\n' "$OPEN_MARKER"
      cat "$SNIPPET"
      printf '%s\n' "$CLOSE_MARKER"
    } >"$target"
    return 0
  fi

  if grep -qxF "$OPEN_MARKER" "$target" || grep -qxF "$CLOSE_MARKER" "$target"; then
    if ! awk -v openm="$OPEN_MARKER" -v closem="$CLOSE_MARKER" '
      $0 == openm { if (inblock || seen) bad = 1; inblock = 1; seen = 1; next }
      $0 == closem { if (!inblock) bad = 1; inblock = 0; next }
      END { if (bad || inblock || !seen) exit 1 }
    ' "$target"; then
      log_error "Malformed dotfiles markers in $target; leaving it unchanged"
      return 1
    fi
  fi

  tmp="$(mktemp "$target.XXXXXX")"
  TMPFILE="$tmp"
  if grep -qxF "$OPEN_MARKER" "$target"; then
    awk -v openm="$OPEN_MARKER" -v closem="$CLOSE_MARKER" -v snippet="$SNIPPET" '
			$0 == openm && !inblock {
				print openm
				while ((getline line < snippet) > 0) print line
				inblock = 1
				next
			}
			inblock && $0 == closem { print closem; inblock = 0; next }
			inblock { next }
			{ print }
		' "$target" >"$tmp"
  else
    cat "$target" >"$tmp"
    {
      printf '\n%s\n' "$OPEN_MARKER"
      cat "$SNIPPET"
      printf '%s\n' "$CLOSE_MARKER"
    } >>"$tmp"
  fi

  chmod --reference="$target" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  mv -f "$tmp" "$target"
  TMPFILE=""
}

changed=0
for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
  before=""
  [ -f "$rc" ] && before="$(cksum <"$rc")"
  merge_block "$rc"
  after=""
  [ -f "$rc" ] && after="$(cksum <"$rc")"
  if [ "$before" != "$after" ]; then
    changed=1
    log_info "Updated the dotfiles block in $rc"
  fi
done

if [ "$changed" -eq 0 ]; then
  log_skip "Shell rc files already carry the dotfiles block"
fi
