#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Re-run when the SSH config payload changes:
# config hash: # {{ include "private_dot_agents/ssh/config" | sha256sum }}
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

set -eo pipefail

SSH_DIR="$HOME/.ssh"
SOURCE="$HOME/.agents/ssh/config"
TARGET="$SSH_DIR/config"

# Anything that exits non-zero here aborts the whole apply and skips every
# later script, so these paths must exit 0. log_warn does not exist in
# scripts/ui.bash; log_skip is the helper that does.
if [ -L "$SSH_DIR" ] && [ ! -e "$SSH_DIR" ]; then
  log_skip "$SSH_DIR is a broken symlink, no SSH config"
  exit 0
fi
if [ -e "$SSH_DIR" ] && [ ! -d "$SSH_DIR" ]; then
  log_skip "$SSH_DIR exists but is not a directory, no SSH config"
  exit 0
fi

# The payload comes from the ai-tooling recipe, so it is absent on a machine
# that ignores it. Missing input is not a reason to fail the apply.
if [ ! -f "$SOURCE" ]; then
  log_skip "$SOURCE is not present, no SSH config"
  exit 0
fi

# Follow an existing symlink or mount, but never replace ~/.ssh itself.
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

# Preserve create_ semantics: an existing config belongs to the machine/user.
if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
  log_skip "$TARGET already exists, leaving it"
  exit 0
fi

install -m 600 "$SOURCE" "$TARGET"
log_info "Installed SSH config"
