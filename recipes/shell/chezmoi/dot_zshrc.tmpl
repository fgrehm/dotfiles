# vim: ft=zsh
# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=()

# User completions directory. Must be 755 (not group-writable) or oh-my-zsh's
# compinit -i will silently drop it from fpath and completions won't load.
mkdir -p "$HOME/.zsh/completions"
chmod 755 "$HOME/.zsh" "$HOME/.zsh/completions"
fpath=("$HOME/.zsh/completions" $fpath)

source $ZSH/oh-my-zsh.sh

# --- History: save on exit, don't share across sessions ---
unsetopt SHARE_HISTORY
unsetopt INC_APPEND_HISTORY
setopt APPEND_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_DUPS

# --- Prompt ---
if [ -f /.dockerenv ] || [ -f /run/.containerenv ] || grep -qaE '(docker|kubepods|containerd)' /proc/1/cgroup 2>/dev/null || [ -n "${CODESPACES:-}" ]; then
function git_ahead_behind() {
    local ahead behind output
    ahead=$(command git rev-list --count @{upstream}..HEAD 2>/dev/null) || return
    behind=$(command git rev-list --count HEAD..@{upstream} 2>/dev/null) || return
    output=""
    (( ahead > 0 )) && output+="🔼 ${ahead} "
    (( behind > 0 )) && output+="🔽 ${behind} "
    [[ -n "$output" ]] && echo "$output"
}

function git_status_emojis() {
    local changes stashes output
    changes=$(command git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    stashes=$(command git stash list 2>/dev/null | wc -l | tr -d ' ')
    output=""
    (( changes > 0 )) && output+="📝 ${changes} "
    (( stashes > 0 )) && output+="📦 ${stashes} "
    [[ -n "$output" ]] && echo "$output"
}

_PROMPT_NL=''
function _precmd_prompt_nl() {
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    _PROMPT_NL=$'\n'
  else
    _PROMPT_NL=''
  fi
}
precmd_functions+=(_precmd_prompt_nl)

PROMPT="🐳 %{$fg[cyan]%}%c%{$reset_color%}"
PROMPT+=' $(git_prompt_info)$(git_status_emojis)$(git_ahead_behind)'
PROMPT+='${_PROMPT_NL}%(?:%{$fg_bold[green]%}%1{➜%} :%{$fg_bold[red]%}%1{➜%} )%{$reset_color%} '
else
eval "$(starship init zsh)"
fi

# Source shared shell configuration (env vars, aliases, PATH)
if [ -f ~/.shellrc ]; then
    . ~/.shellrc
fi
