# shellcheck shell=bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# General-purpose aliases shared across bash and zsh.

# Open files and URLs with the desktop default application.
open() (
  xdg-open "$@" >/dev/null 2>&1 &
)

# --- Colors ---
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# --- ls shortcuts ---
if command -v eza &>/dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias ll='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
else
  alias ll='ls -alFh'
  alias la='ls -A'
  alias l='ls -CF'
fi

# --- ruby stuff ---
alias be='bundle exec'
alias rails='bin/rails'
alias rc='./bin/rails console'
alias rspec='bundle exec rspec'

# --- Project shortcuts (cdp/cdpo/cdw) ---
# cd into ~/Projects, ~/Projects/oss, or ~/Work with tab-completion.
# Skipped in containers (no project directories there).
# {{ if not .isContainer }}
cdp() { cd "$HOME/Projects/${1:-}" || return; }
cdpo() { cd "$HOME/Projects/oss/${1:-}" || return; }
cdw() { cd "$HOME/Work/${1:-}" || return; }

if [ -n "$BASH_VERSION" ]; then
  _cdp_complete() {
    local base="$HOME/Projects"
    [[ "${COMP_WORDS[0]}" == cdpo ]] && base="$HOME/Projects/oss"
    [[ "${COMP_WORDS[0]}" == cdw ]] && base="$HOME/Work"
    local cur="${COMP_WORDS[COMP_CWORD]}"
    # Complete dirs under $base, allowing descent into subfolders. Every match
    # ends with "/" and nospace is set, so Tab keeps drilling into nested dirs
    # instead of only offering top-level projects.
    local dir="$base" prefix="" word="${cur##*/}" d name
    if [[ "$cur" == */* ]]; then
      dir="$base/${cur%/*}"
      prefix="${cur%/*}/"
    fi
    COMPREPLY=()
    for d in "$dir"/*/; do
      [[ -d "$d" ]] || continue
      name="${d%/}"
      name="${name##*/}"
      [[ "$name" == "$word"* ]] || continue
      COMPREPLY+=("$prefix$name/")
    done
    compopt -o nospace
  }
  complete -F _cdp_complete cdp cdpo cdw
elif [ -n "$ZSH_VERSION" ]; then
  # shellcheck disable=SC1087,SC2154,SC2193 # zsh $words array
  _cdp() {
    local base="$HOME/Projects"
    [[ "${words[1]}" == cdpo ]] && base="$HOME/Projects/oss"
    [[ "${words[1]}" == cdw ]] && base="$HOME/Work"
    _files -W "$base" -/
  }
  compdef _cdp cdp cdpo cdw
fi
# {{ end }}
