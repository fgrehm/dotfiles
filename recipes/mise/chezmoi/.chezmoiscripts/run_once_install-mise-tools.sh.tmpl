#!/usr/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

if ! command -v mise &>/dev/null; then
  log_skip "mise not found, skipping mise-managed tools"
  exit 0
fi

set -eo pipefail

# {{ if .hasToolchain }}
# The platform owns the toolchain: it bakes mise and its toolset into the
# image and points MISE_GLOBAL_CONFIG_FILE at a config outside $HOME. Writing
# to that config with `mise use -g` would rewrite the platform's deliberate
# version pins and lose the change when the container is replaced, so dotfiles
# installs nothing here. A tool the guest needs belongs in the platform image.
log_skip "toolchain is provided by the platform, not installing tools"
missing=""
for tool in jq nvim shfmt bunx shellcheck prek wt hunk gitleaks gh bat; do
  command -v "$tool" &>/dev/null || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  log_info "not provided by the platform:$missing"
  log_info "add them to the platform image to make them available in this guest"
fi
exit 0
# {{ else }}

install_tool() {
  local package="$1" command="$2"
  if command -v "$command" &>/dev/null; then
    log_skip "$command already available"
    return
  fi

  log_info "Installing $command through mise..."
  # {{ if .isOmarchy }}
  omarchy-mise-install "$package" "$command"
  # omarchy-mise-install creates a lazy wrapper; install the tool now.
  "$command" --version >/dev/null
  # {{ else }}
  mise use -g "${package}@latest"
  "$command" --version >/dev/null
  # {{ end }}
}

install_tool jq jq
install_tool neovim nvim
install_tool shfmt shfmt
install_tool bun bunx
install_tool shellcheck shellcheck
install_tool prek prek
install_tool worktrunk wt
install_tool aqua:modem-dev/hunk hunk
install_tool aqua:gitleaks/gitleaks gitleaks
install_tool gh gh
install_tool bat bat
# {{ end }}
