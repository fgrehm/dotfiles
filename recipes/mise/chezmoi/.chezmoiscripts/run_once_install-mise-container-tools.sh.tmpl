#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

# Containers do not run the full development-tool recipe, but these tools are
# needed by the dotfiles themselves and can be installed without root.
# {{ if not .isContainer }}
log_skip "Container-only mise tools"
exit 0
# {{ end }}

if ! command -v mise &>/dev/null; then
  log_skip "mise not found, skipping container tools"
  exit 0
fi

set -eo pipefail

install_tool() {
  local package="$1" command="$2"
  if command -v "$command" &>/dev/null; then
    log_skip "$command already installed"
    return
  fi

  log_info "Installing $command through mise..."
  mise use -g "${package}@latest"
  "$command" --version >/dev/null
}

install_tool jq jq
install_tool neovim nvim
install_tool shfmt shfmt
install_tool bun bunx
install_tool shellcheck shellcheck
install_tool prek prek
