#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# config hash: # {{ include "private_dot_config/tinted-theming/tinty/config.toml" | sha256sum }}
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

export PATH="$HOME/.local/bin:$PATH"

if ! command -v tinty &>/dev/null; then
  log_skip "tinty not installed, skipping theme setup"
  exit 0
fi

set -eo pipefail

log_info "Fetching tinty template repositories..."
run_quiet tinty install

CURRENT=$(tinty current 2>/dev/null || true)
[ -z "$CURRENT" ] && CURRENT="base16-gruvbox-dark-hard"

log_info "Applying theme: $CURRENT..."
run_quiet tinty apply "$CURRENT"
