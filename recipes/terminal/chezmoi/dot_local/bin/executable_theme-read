#!/bin/sh
# Print the effective theme for this process.
# Resolution: per-window > global > hardcoded default.
DEFAULT="base16-gruvbox-dark-hard"

if [ -n "${ALACRITTY_WINDOW_ID:-}" ]; then
  _wf="${XDG_RUNTIME_DIR:-/tmp}/theme/window-$ALACRITTY_WINDOW_ID"
  if [ -f "$_wf" ]; then
    cat "$_wf"
    exit 0
  fi
fi

_gf="$HOME/.local/share/theme/current"
if [ -f "$_gf" ]; then
  cat "$_gf"
  exit 0
fi

printf '%s\n' "$DEFAULT"
