#!/bin/bash
# Switch base16 themes across all integrated apps.
#
# Per-window (default):
#   theme <name>         apply to this Alacritty window only
#   theme reset          clear per-window override, revert to global
#
# Global:
#   theme -g <name>      apply everywhere via tinty
#   theme -g reset       clear all per-window overrides
#
# Other:
#   theme list           list available schemes
#   theme pick           fzf picker
#   theme current        show effective theme for this window

TINTY_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
WINDOW_THEME_DIR="${XDG_RUNTIME_DIR:-/tmp}/theme"
CUSTOM_THEME_DIR="$HOME/.config/alacritty/themes"
GLOBAL=0

_custom_file() {
  # Print the custom theme file for $1 if one exists; nothing otherwise.
  [ -f "$CUSTOM_THEME_DIR/$1.toml" ] && printf '%s\n' "$CUSTOM_THEME_DIR/$1.toml"
}

_resolve() {
  # Custom themes (~/.config/alacritty/themes/*.toml) keep their bare name so
  # tinty never sees them. Everything else is normalized to a base16-* scheme.
  if [ -n "$(_custom_file "$1")" ]; then
    printf '%s' "$1"
    return
  fi
  case "$1" in
    gruvbox)      printf 'base16-gruvbox-dark-hard' ;;
    dracula)      printf 'base16-dracula' ;;
    catppuccin)   printf 'base16-catppuccin-mocha' ;;
    nord)         printf 'base16-nord' ;;
    tokyo-night)  printf 'base16-tokyo-night-storm' ;;
    rose-pine)    printf 'base16-rose-pine' ;;
    everforest)   printf 'base16-everforest' ;;
    *)            printf 'base16-%s' "${1#base16-}" ;;
  esac
}

_colors_file() {
  # Resolve a scheme name to its alacritty colors file (custom or tinty repo).
  local scheme="$1"
  local custom
  custom=$(_custom_file "$scheme")
  if [ -n "$custom" ]; then
    printf '%s\n' "$custom"
  else
    printf '%s/repos/tinted-alacritty/colors/%s.toml\n' "$TINTY_DATA" "$scheme"
  fi
}

_apply_window() {
  local scheme="$1"
  local colors_file
  colors_file=$(_colors_file "$scheme")

  if [ ! -f "$colors_file" ]; then
    printf 'error: no theme file for %s (run: tinty install)\n' "$scheme" >&2
    return 1
  fi

  mkdir -p "$WINDOW_THEME_DIR"
  printf '%s\n' "$scheme" >"$WINDOW_THEME_DIR/window-${ALACRITTY_WINDOW_ID:-default}"

  if [ -n "${ALACRITTY_SOCKET:-}" ] && command -v alacritty >/dev/null 2>&1; then
    alacritty msg config -r 2>/dev/null || true
    alacritty msg config "$(cat "$colors_file")" 2>/dev/null || true
  fi

  printf 'Applied %s (this window)\n' "$scheme"
}

_apply_global_custom() {
  # tinty doesn't know custom themes, so reuse the same hook directly.
  local scheme="$1"
  local colors_file
  colors_file=$(_custom_file "$scheme")
  if [ -z "$colors_file" ]; then
    printf 'error: no custom theme file for %s\n' "$scheme" >&2
    return 1
  fi
  # The global hook reads the active scheme name from tinty's current_scheme
  # file; write it ourselves so theme-read reports the right thing.
  mkdir -p "$TINTY_DATA"
  printf '%s\n' "$scheme" >"$TINTY_DATA/current_scheme"
  "$HOME/.local/bin/theme-apply-global" "$colors_file"
  printf 'Applied %s (global)\n' "$scheme"
}

# Strip leading -g / --global flags
while [ "${1:-}" = "-g" ] || [ "${1:-}" = "--global" ]; do
  GLOBAL=1
  shift
done

CMD="${1:-}"
case "$CMD" in
  list)
    {
      tinty list
      if [ -d "$CUSTOM_THEME_DIR" ]; then
        for f in "$CUSTOM_THEME_DIR"/*.toml; do
          [ -f "$f" ] || continue
          basename "$f" .toml
        done
      fi
    } | sort -u
    ;;
  pick)
    if ! command -v fzf >/dev/null 2>&1; then
      printf 'error: fzf not installed\n' >&2
      exit 1
    fi
    SCHEME=$("$0" list | fzf --height=40% --layout=reverse)
    [ -z "$SCHEME" ] && exit 0
    RESOLVED=$(_resolve "$SCHEME")
    if [ "$GLOBAL" = 1 ]; then
      if [ -n "$(_custom_file "$RESOLVED")" ]; then
        _apply_global_custom "$RESOLVED"
      else
        tinty apply "$RESOLVED"
      fi
    else
      _apply_window "$RESOLVED"
    fi
    ;;
  current)
    theme-read
    ;;
  reset)
    if [ "$GLOBAL" = 1 ]; then
      rm -f "$WINDOW_THEME_DIR"/window-* 2>/dev/null || true
      printf 'All per-window overrides cleared. Effective: %s\n' "$(theme-read)"
    else
      rm -f "$WINDOW_THEME_DIR/window-${ALACRITTY_WINDOW_ID:-}" 2>/dev/null || true
      printf 'Override cleared. Effective: %s\n' "$(theme-read)"
    fi
    ;;
  "")
    printf 'Usage: theme [-g] <scheme>   e.g. theme gruvbox, theme -g catppuccin\n'
    printf '       theme list | pick | current | reset\n'
    exit 1
    ;;
  *)
    SCHEME=$(_resolve "$CMD")
    if [ "$GLOBAL" = 1 ]; then
      if [ -n "$(_custom_file "$SCHEME")" ]; then
        _apply_global_custom "$SCHEME"
      else
        tinty apply "$SCHEME"
      fi
    else
      _apply_window "$SCHEME"
    fi
    ;;
esac
