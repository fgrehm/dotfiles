# The voxtype GPU drop-in pins VOXTYPE_VULKAN_DEVICE=nvidia, which only makes
# sense on machines with an NVIDIA GPU. Skip it otherwise.
{{ if not .hasNvidiaGPU }}
.config/systemd/user/voxtype.service.d/gpu.conf
{{ end }}

# Ghostty is only installed on Omarchy 3.8 (on 4.0 foot is the default terminal
# and supports images via sixel). Skip the ghostty config on 4.0 so we don't
# deploy config for a terminal that isn't installed.
{{ if .isOmarchy4 }}
.config/ghostty/config
.config/ghostty/keybinds.conf
.config/ghostty/padding.conf
{{ end }}
