# Overrides omarchy's default ghostty config.
#
# Include omarchy's default ghostty config, then apply overrides.
#
# IMPORTANT: ghostty processes every `config-file` entry AFTER the main file,
# so anything set here is overridden by omarchy's default config. Overrides
# that must win over omarchy live in keybinds.conf (the last config-file),
# which loads after omarchy's config.
#
# Omarchy's default config location differs by version:
#   3.8: ~/.local/share/omarchy/config/ghostty/config
#   4.0: /usr/share/omarchy/config/ghostty/config  (OMARCHY_PATH)
config-file = ?"{{ if .isOmarchy4 }}/usr/share/omarchy{{ else }}~/.local/share/omarchy{{ end }}/config/ghostty/config"
config-file = ?"~/.config/ghostty/padding.conf"
config-file = ?"~/.config/ghostty/keybinds.conf"