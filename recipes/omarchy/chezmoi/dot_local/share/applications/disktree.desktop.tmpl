[Desktop Entry]
Type=Application
Version=1.0
Name=disktree
GenericName=Disk space treemap
Comment=Find what is using a volume, mark what should go, remove it
Exec={{ .chezmoi.homeDir }}/.local/bin/disktree %f
Icon=disktree
Terminal=false
Categories=System;Filesystem;
Keywords=disk;space;usage;du;treemap;cleanup;
StartupNotify=true
StartupWMClass=disktree
# Registered for directories, so a file manager can offer "Open with disktree".
# This adds a handler; it does not become the default.
MimeType=inode/directory;
Actions=disk;

[Desktop Action disk]
Name=Scan the whole disk
Exec={{ .chezmoi.homeDir }}/.local/bin/disktree --disk
