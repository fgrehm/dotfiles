#!/usr/bin/env bash
# Back up selected local work to an encrypted Restic repository on an external drive.

set -eo pipefail

config="$HOME/.config/wip-backup/config.sh"
history="$HOME/.config/omarchy/screen-time/history.json"
dry_run=false

usage() {
  printf 'Usage: wip-backup [--dry-run]\n' >&2
}

log_error() {
  printf 'wip-backup: %s\n' "$*" >&2
}

if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != "--dry-run" ]]; }; then
  usage
  exit 2
fi
[[ ${1:-} == "--dry-run" ]] && dry_run=true

if [[ ! -r $config ]]; then
  log_error "missing config: $config"
  exit 1
fi
# This is a user-owned shell config, not a file downloaded from Dropbox.
# shellcheck disable=SC1090
source "$config"

if [[ -z ${BACKUP_MOUNTPOINT:-} || -z ${RESTIC_REPOSITORY:-} ]]; then
  log_error "set BACKUP_MOUNTPOINT and RESTIC_REPOSITORY in $config"
  exit 1
fi
if [[ ! -f ${RESTIC_PASSWORD_FILE:-} || ! -r $RESTIC_PASSWORD_FILE ]]; then
  log_error "Restic password file is missing or unreadable: ${RESTIC_PASSWORD_FILE:-unset}"
  exit 1
fi

if ! command -v restic >/dev/null 2>&1; then
  log_error "restic is not installed"
  exit 1
fi

mountpoint_path=$(realpath -e -- "$BACKUP_MOUNTPOINT") || {
  log_error "external drive mount point does not exist: $BACKUP_MOUNTPOINT"
  exit 1
}
if ! mountpoint -q -- "$mountpoint_path"; then
  log_error "external drive is not mounted at $mountpoint_path"
  exit 1
fi
mount_options=$(findmnt -rn -o OPTIONS --target "$mountpoint_path") || {
  log_error "could not inspect mount options for $mountpoint_path"
  exit 1
}
case ",$mount_options," in
  *,rw,*) ;;
  *)
    log_error "external drive is not mounted read-write"
    exit 1
    ;;
esac

repository_path=$(realpath -m -- "$RESTIC_REPOSITORY") || {
  log_error "could not resolve Restic repository path"
  exit 1
}
case "$repository_path" in
  "$mountpoint_path"/*) ;;
  *)
    log_error "Restic repository must be inside the mounted external drive"
    exit 1
    ;;
esac
password_path=$(realpath -m -- "$RESTIC_PASSWORD_FILE") || {
  log_error "could not resolve Restic password file path"
  exit 1
}
case "$password_path" in
  "$mountpoint_path" | "$mountpoint_path"/*)
    log_error "keep the Restic password file off the external backup drive"
    exit 1
    ;;
esac
password_mode=$(stat -c '%a' -- "$RESTIC_PASSWORD_FILE")
if (( (8#$password_mode & 077) != 0 )); then
  log_error "Restic password file must not be accessible by group or other users (chmod 600)"
  exit 1
fi

sensitive_roots=()
for sensitive_path in "$HOME/.ssh" "$HOME/.bb" "$HOME/.config/bb" "${BB_DATA_DIR:-}" "${BB_THREAD_STORAGE:-}"; do
  [[ -n $sensitive_path ]] || continue
  sensitive_roots+=("$(realpath -m -- "$sensitive_path")")
done
restic_exclude_args=(--exclude '**/.ssh' --exclude '**/.bb')
for sensitive_path in "${sensitive_roots[@]}"; do
  restic_exclude_args+=(--exclude "$sensitive_path")
done

sources=()
add_configured_sources() {
  local source_path resolved sensitive_root
  for source_path in "$@"; do
    [[ -n $source_path ]] || continue
    if [[ ! -e $source_path ]]; then
      log_error "configured backup source does not exist: $source_path"
      exit 1
    fi
    resolved=$(realpath -e -- "$source_path") || {
      log_error "could not resolve backup source: $source_path"
      exit 1
    }
    if [[ $resolved == "$mountpoint_path" || $resolved == "$mountpoint_path"/* ]]; then
      log_error "backup source must not be on the external backup drive: $resolved"
      exit 1
    fi
    for sensitive_root in "${sensitive_roots[@]}"; do
      if [[ $resolved == "$sensitive_root" || $resolved == "$sensitive_root"/* ]]; then
        log_error "backup source must not be sensitive SSH or BB data: $resolved"
        exit 1
      fi
    done
    if [[ $repository_path == "$resolved" || $repository_path == "$resolved"/* ||
      $resolved == "$repository_path" || $resolved == "$repository_path"/* ]]; then
      log_error "backup source and Restic repository must not contain one another: $resolved"
      exit 1
    fi
    sources+=("$resolved")
  done
}

if (( ${#DROPBOX_PATHS[@]} == 0 )); then
  log_error "configure DROPBOX_PATHS with local, offline-available Dropbox files/folders in $config"
  exit 1
fi
if (( ${#PROJECT_PATHS[@]} == 0 )); then
  log_error "configure at least one PROJECT_PATHS root in $config"
  exit 1
fi
add_configured_sources "${DROPBOX_PATHS[@]}"
add_configured_sources "${PROJECT_PATHS[@]}"

if [[ -f $history ]]; then
  add_configured_sources "$history"
else
  printf 'wip-backup: Screen Time history not present yet; skipping it\n' >&2
fi
if (( ${#sources[@]} == 0 )); then
  log_error "no backup sources were configured"
  exit 1
fi

export RESTIC_REPOSITORY="$repository_path"
export RESTIC_PASSWORD_FILE="$password_path"
if ! restic cat config >/dev/null; then
  log_error "Restic repository is not initialized or cannot be unlocked; initialize it manually first"
  exit 1
fi

backup_args=(backup --tag wip)
if [[ $dry_run == true ]]; then
  backup_args+=(--dry-run)
fi
backup_args+=("${restic_exclude_args[@]}")
backup_args+=(-- "${sources[@]}")
restic "${backup_args[@]}"
