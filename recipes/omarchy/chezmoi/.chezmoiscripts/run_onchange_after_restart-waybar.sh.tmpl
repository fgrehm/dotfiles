#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# config hash: # {{ include "private_dot_config/waybar/config.jsonc" | sha256sum }}
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

if ! command -v omarchy &>/dev/null; then
  log_skip "omarchy not found, skipping waybar restart"
  exit 0
fi

log_info "Restarting waybar to apply config changes..."
if ! omarchy restart waybar; then
  log_error "Failed to restart waybar (non-fatal)"
fi
