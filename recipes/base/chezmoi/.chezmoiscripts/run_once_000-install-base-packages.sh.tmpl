#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

# Use sudo only when it is authorized without prompting.
if [ "$(id -u)" -ne 0 ] && command -v sudo &>/dev/null && sudo -n true 2>/dev/null; then
  SUDO="sudo"
else
  SUDO=""
fi

# binary:package pairs. Package names differ per-OS: `fd` on Omarchy (Arch),
# `fd-find` on Debian-based containers (binary ships as `fdfind`).
# {{ if .isOmarchy }}
declare -A pkgs=([jq]=jq [unzip]=unzip [wget]=wget [gpg]=gnupg [fdfind]=fd)
# {{ else }}
declare -A pkgs=([jq]=jq [unzip]=unzip [wget]=wget [gpg]=gnupg [fdfind]=fd-find)
# {{ end }}

packages=()
for bin in "${!pkgs[@]}"; do
  command -v "$bin" &>/dev/null || packages+=("${pkgs[$bin]}")
done

# On Omarchy, fd installs as `fd`; scripts expect `fdfind`, so we symlink it.
# {{ if .isOmarchy }}
fdfind_ok=0
if command -v fdfind &>/dev/null; then
  fdfind_ok=1
fi
# {{ end }}

if [ ${#packages[@]} -eq 0 ] && [ "${fdfind_ok:-1}" -eq 1 ]; then
  log_skip "base packages already installed"
  exit 0
fi

set -eo pipefail

if [ ${#packages[@]} -gt 0 ]; then
  if [ "$(id -u)" -ne 0 ] && [ -z "$SUDO" ]; then
    log_skip "Cannot install base packages without root or usable sudo: ${packages[*]}"
    exit 0
  fi
  log_info "Installing base packages: ${packages[*]}..."
  # Omarchy: pacman via omarchy pkg. Containers: apt.
  # {{ if .isOmarchy }}
  run_quiet omarchy pkg add "${packages[@]}"
  # {{ else }}
  run_quiet $SUDO apt-get update -qq
  run_quiet $SUDO apt-get install -y "${packages[@]}"
  # {{ end }}
fi

# {{ if .isOmarchy }}
# Ensure fdfind is available (fd installs as `fd` on Omarchy).
if command -v fd &>/dev/null && ! command -v fdfind &>/dev/null; then
  mkdir -p "$HOME/.local/bin"
  ln -sf "$(command -v fd)" "$HOME/.local/bin/fdfind"
fi
# {{ end }}
