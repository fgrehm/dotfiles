#!/usr/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Re-run when the managed settings change:
# managed-hash: # {{ include ".chezmoitemplates/pi-settings.managed.json" | sha256sum }}
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

set -eo pipefail

if ! command -v jq &>/dev/null; then
  log_error "jq required for Pi settings merge"
  exit 1
fi

TARGET="$HOME/.pi/agent/settings.json"
MANAGED="$(mktemp)"
trap 'rm -f "$MANAGED"' EXIT

cat >"$MANAGED" <<'PI_SETTINGS_MANAGED_JSON'
# {{ include ".chezmoitemplates/pi-settings.managed.json" }}
PI_SETTINGS_MANAGED_JSON

if ! jq -e 'type == "object"' "$MANAGED" >/dev/null 2>&1; then
  log_error "Managed Pi settings fragment is not valid JSON"
  exit 1
fi

# ~/.pi/agent/settings.json is Pi's own file and stays machine-local: the
# package list (version floors), models, and anything a hand-edit added are not
# ours to own. We only upsert the keys in the fragment, which is why this merge
# is a shallow one. Shallow is the safe depth here because the fragment carries
# scalars only; shipping a nested object would replace that whole subtree
# instead of merging into it.
#
# A missing file is seeded from the fragment. An unreadable or non-object file
# is left alone and reported: this runs during chezmoi apply, and clobbering a
# file we could not parse would destroy settings we do not even understand.
if [ ! -e "$TARGET" ]; then
  mkdir -p "$(dirname "$TARGET")"
  jq . "$MANAGED" >"$TARGET"
  log_info "Seeded $TARGET from managed Pi settings"
  exit 0
fi

if ! jq -e 'type == "object"' "$TARGET" >/dev/null 2>&1; then
  log_error "$TARGET is not valid JSON, leaving it alone"
  exit 0
fi

merged="$(jq -s '.[0] * .[1]' "$TARGET" "$MANAGED")"

# Name the keys that actually move, and nothing else. chezmoi diff cannot help
# here: scripts are not part of the diff, and settings.json is machine-local and
# untracked, so without this the only signal is that a write happened.
#
# Values are rendered as compact JSON, so strings keep their quotes and the
# before/after of a key is unambiguous rather than a bare run of words. A key
# absent on one side prints as `null`, which is the case worth seeing anyway
# (it is how a fragment key lands on a machine that never had it).
#
# The old value is looked up with `has`/index, not with `//`: `false // null`
# is `null` in jq, because `false` is falsy. A boolean setting that flipped
# false -> true would otherwise be reported as "null -> true".
changed="$(jq -r -s '
  def old($local; $key): if $local | has($key) then $local[$key] else null end;
  .[0] as $local | .[1] as $managed |
  $managed
  | to_entries
  | map(select(old($local; .key) != .value))
  | .[]
  | "\(.key): \(old($local; .key) | @json) -> \(.value | @json)"
' "$TARGET" "$MANAGED")"

if [ -z "$changed" ]; then
  log_skip "Pi settings already match the managed keys"
  exit 0
fi

printf '%s\n' "$merged" | jq . >"$TARGET.tmp"
mv "$TARGET.tmp" "$TARGET"
log_info "Merged managed Pi settings into $TARGET"
printf '%s\n' "$changed" | while IFS= read -r line; do
  log_info "  $line"
done
