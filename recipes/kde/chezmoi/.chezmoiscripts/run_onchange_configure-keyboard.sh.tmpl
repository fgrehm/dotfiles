#!/bin/env bash
# vim: ft=bash.gotmpl
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
source "$CHEZMOI_SOURCE_DIR/scripts/ui.bash"

if [ "${XDG_CURRENT_DESKTOP:-}" != "KDE" ]; then
  log_skip "Not running KDE Plasma, skipping keyboard configuration"
  exit 0
fi

if ! command -v kwriteconfig6 &>/dev/null; then
  log_skip "kwriteconfig6 not found, skipping keyboard configuration"
  exit 0
fi

set -eo pipefail

# Configure keyboard layouts: US and US International (dead keys)
log_info "Configuring keyboard layouts (us, us-intl)..."
kwriteconfig6 --file kxkbrc --group Layout --key Use --type bool true
kwriteconfig6 --file kxkbrc --group Layout --key LayoutList "us,us"
kwriteconfig6 --file kxkbrc --group Layout --key VariantList ",intl"
kwriteconfig6 --file kxkbrc --group Layout --key DisplayNames ","
kwriteconfig6 --file kxkbrc --group Layout --key LayoutLoopCount -- -1
kwriteconfig6 --file kxkbrc --group Layout --key Options "caps:ctrl_modifier"
kwriteconfig6 --file kxkbrc --group Layout --key ResetOldOptions --type bool true
kwriteconfig6 --file kxkbrc --group Layout --key SwitchMode "Global"
kwriteconfig6 --file kxkbrc --group Layout --key ShowLayoutIndicator --type bool true
kwriteconfig6 --file kxkbrc --group Layout --key ShowFlag --type bool false

# Set Super+Space as shortcut to switch keyboard layout
log_info "Setting Super+Space as layout switch shortcut..."
kwriteconfig6 --file kglobalshortcutsrc \
  --group "KDE Keyboard Layout Switcher" \
  --key "Switch to Next Keyboard Layout" \
  "Meta+Space,Meta+Alt+K,Switch to Next Keyboard Layout"

# Reload keyboard config
if command -v dbus-send &>/dev/null; then
  dbus-send --session --dest=org.kde.keyboard /Layouts org.kde.keyboard.reloadConfig 2>/dev/null || true
fi
